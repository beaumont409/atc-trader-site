# Copy this file to .env and fill in each value before running locally.
# Never commit .env to git — it contains secrets.

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/atc_trader

# Gmail address used to send AND receive lead notification emails
GMAIL_ADDRESS=chaddubois21@gmail.com

# Gmail App Password (16-char code from Google Account → Security → App passwords)
# Requires 2-Step Verification to be enabled on the Gmail account
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Random secret string used for session signing — any long random value works
SESSION_SECRET=replace-with-a-long-random-string

# Port for the API server
PORT=8080
